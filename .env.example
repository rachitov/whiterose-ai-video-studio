PORT=3000
# Supabase project URL and publishable/anon key (never use the service-role key here)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Create this email/password user in Supabase Auth; keep credentials only in .env
DEMO_EMAIL=
DEMO_PASSWORD=
# Needed for "Plan with AI". Keep this file private; never commit the real .env
ANTHROPIC_API_KEY=
# Magic Hour API key. Create one in the Magic Hour Developer Hub.
MAGIC_HOUR_API_KEY=
# Optional legacy alias.
MAGICHOUR_API_KEY=
# Google Gemini API key for Veo 3.1 video and Nano Banana image generation.
GEMINI_API_KEY=
# Optional legacy alias.
GOOGLE_GEMINI_API_KEY=
# OpenAI API key for GPT Image generation; image requests may incur charges.
OPENAI_API_KEY=
# Higgsfield API key as KEY_ID:KEY_SECRET; separate HF_API_KEY_ID and
# HF_API_KEY_SECRET variables are also accepted.
HIGGSFIELD_API_KEY=
